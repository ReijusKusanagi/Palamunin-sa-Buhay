import java.util.Scanner;

public class App {
    public static void main(String[] args) throws Exception {
        int celsius;
        double fahrenheit;

        Scanner userInput = new Scanner(System.in);

        System.out.print("Enter temperature in Celsius: ");

        celsius = userInput.nextInt();
        fahrenheit = (celsius * 9.0 / 5.0) + 32;

        System.out.println("Temperature in Fahrenheit:" + fahrenheit);

        if(fahrenheit < 80) {
            System.out.println("The temperature outside is safe.");
        }else if(fahrenheit >= 80 && fahrenheit <= 90){
            System.out.println("Caution");
        }else if(fahrenheit >= 90 && fahrenheit <= 105){
            System.out.println("EXTREME Caution");
        }else if(fahrenheit >= 105 && fahrenheit <= 130){
            System.out.println("Danger!!! Stay Hydrated!!!");
        }else if(fahrenheit > 130){
            System.out.println("Extreme Danger!!! Stay Indoors and stay hydrated!!!");

    } 
