        if(gwa >= 3.5 && isEnrolled){
            System.out.println("Status: Honor Student");
        } else if(gwa >= 2.0 && isEnrolled){
            System.out.println("Status: Regular Student");
        } else if (gwa < 2.0 && isEnrolled) {
            System.out.println("Status: Probationary Student");
        } else {
