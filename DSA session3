import java.util.Scanner;

public class App {
    public static void main(String[] args) throws Exception {
        Scanner user_input = new Scanner(System.in);
       // Repetition Control Structure
       /*
        1. While Loop
        2. Do While Loop
        3. For Loop
        */

        // [SECTION] While Loop
        /*
         SYNTAX:
         while(condition){
              //code
              //iterator -> key to make repetition
         }
         */
        int x = 0;
        while(x <= 3){
            System.out.println("While Loop: " + x);
            x++;
        }

        // [SECTION] Do While Loop
        /*
          SYNTAX:
         do{
         //code
         //iterator
         }while(condtion); 
        */

        int y= 0;
        
        do{
            System.out.println("Do While Loop: " + y); //code
            y++; // iterator
        }while(y >= 3);

        // [SECTION] For Loop

        /*
         SYNTAX:
         
         for(initialization; condition; iterator/update){
              //code
         }
        */

        for(int count = 0; count <= 3; count++){
        System.out.println("For Loop: " + count);
        }

        int value;
        System.out.print("Enter Value: ");
        value = user_input.nextInt();

        for(int i = 0; i <= value; i++){
            if(i == 27){
                break;
            }
            if(i % 2 == 0){
                continue;
            }else{
                System.out.println("Count: " + i);
            }
        }

        user_input.close();
    }
}
